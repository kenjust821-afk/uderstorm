generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String
  price          Float
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  images         String
  sizes          String
  colors         String
  stock          Int      @default(0)
  stockByVariant String   @default("{}")
  featured       Boolean  @default(false)
  newArrival     Boolean  @default(false)
  bestSeller     Boolean  @default(false)
  soldOut        Boolean  @default(false)
  active         Boolean  @default(true)
  rating         Float    @default(0)
  reviewCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Order {
  id           String   @id @default(cuid())
  reference    String   @unique
  customerName String
  phone        String
  whatsapp     String
  email        String?
  address      String
  state        String
  city         String
  items        String
  total        Float
  status       String   @default("New Order")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  comment   String
  date      String
  image     String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SizeGuide {
  id        String   @id @default(cuid())
  category  String   @unique
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
